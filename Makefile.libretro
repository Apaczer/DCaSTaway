# DCaSTaway libretro Makefile
# Atari ST emulator ported from Dingoo/Dreamcast/Miyoo

NAME    = dcastaway
O       = o
RM      = rm -f

ifeq ($(platform), miyoo)
   TARGET := $(NAME)_libretro.so
   CC = /opt/miyoo/usr/bin/arm-linux-gcc
   CXX = /opt/miyoo/usr/bin/arm-linux-g++
   AR = /opt/miyoo/usr/bin/arm-linux-ar
   CFLAGS += -fPIC
   CFLAGS += -fomit-frame-pointer -ffast-math -march=armv5te -mtune=arm926ej-s
   CXXFLAGS += $(CFLAGS)
   LDFLAGS += -shared -lm
else
    # Unix (for testing)
    TARGET = $(NAME)_libretro.so
    CC ?= gcc
    CXX ?= g++
    CFLAGS += -fPIC
    LDFLAGS = -shared -lm
endif

all: $(TARGET)

# Use FAME 68000 core (same as UAE4ALL and DCaSTaway Miyoo)
FAME_CORE = 1

# Include paths
CFLAGS += -Isrc -Isrc/m68k -Isrc/st -Isrc/menu -Isrc/vkbd -Isrc/unzip -Isrc/sound
CFLAGS += -Ilibretro

# Use SDL compatibility layer instead of real SDL
CFLAGS += -include libretro/sdl_compat.h

# Platform defines
CFLAGS += -D__LIBRETRO__
CFLAGS += -DROM_PATH_PREFIX=\"./\"
CFLAGS += -DDATA_PREFIX=\"./data/\"
CFLAGS += -DSAVE_PREFIX=\"./\"
CFLAGS += -DFILE_SEPARATOR=\"/\"

# Disable features not needed in LIBRETRO
# CFLAGS += -DNO_SOUND
CFLAGS += -DNO_MENU
CFLAGS += -DNO_VKBD
CFLAGS += -DALWAYS_LOW
CFLAGS += -DNO_USE_TV_FILTER
CFLAGS += -DEMULATED_JOYSTICK
CFLAGS += -DNO_ZLIB

# Optimization
ifeq ($(DEBUG), 1)
    CFLAGS += -O0 -g -DDEBUG
else
    CFLAGS += -O3
endif

CFLAGS += -Wno-unused -Wno-format -Wno-sign-compare
CFLAGS += -fno-exceptions -fno-rtti -fno-threadsafe-statics

CXXFLAGS = $(CFLAGS)

# Object files - Core emulation
OBJS = \
	src/dcastaway.o \
	src/events.o \
	src/render.o \
	src/save.o \
	src/savedisk.o \
	src/disk.o \
	src/icon.o \
	src/st/init.o \
	src/st/st.o \
	src/st/mem.o \
	src/st/ikbd.o \
	src/st/blitter.o \
	src/st/fdc.o \
	src/st/tos.o \
	src/sound/sound.o

# Libretro wrapper (replaces main.cpp and SDL platform code)
# Note: .cpp file to properly link with C++ emulator code
OBJS += libretro/libretro-castaway.o

# Force C++ compilation for libretro wrapper
libretro/libretro-castaway.o: libretro/libretro-castaway.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

# FAME 68000 CPU core (same as UAE4ALL)
ifdef FAME_CORE
CFLAGS += -DUSE_FAME_CORE -DUSE_FAME_CORE_C
CFLAGS += -DFAME_IRQ_CLOCKING -DFAME_CHECK_BRANCHES -DFAME_EMULATE_TRACE
CFLAGS += -DFAME_DIRECT_MAPPING -DFAME_BYPASS_TAS_WRITEBACK -DFAME_ACCURATE_TIMING
CFLAGS += -DFAME_GLOBAL_CONTEXT -DFAME_FETCHBITS=8 -DFAME_DATABITS=8
CFLAGS += -DFAME_NO_RESTORE_PC_MASKED_BITS
CFLAGS += -DINLINE=__inline__
OBJS += src/m68k/fame/famec.o
OBJS += src/m68k/fame/m68k_intrf.o
else
# Original Castaway 68000 core
OBJS += \
	src/m68k/castaway/68000.o \
	src/m68k/castaway/debug.o \
	src/m68k/castaway/op68kadd.o \
	src/m68k/castaway/op68karith.o \
	src/m68k/castaway/op68klogop.o \
	src/m68k/castaway/op68kmisc.o \
	src/m68k/castaway/op68kmove.o \
	src/m68k/castaway/op68kshift.o \
	src/m68k/castaway/op68ksub.o
endif

# Build rules
$(TARGET): $(OBJS)
ifeq ($(STATIC_LINKING), 1)
	$(AR) rcs $@ $(OBJS)
else
	$(CXX) $(LDFLAGS) -o $@ $(OBJS)
endif

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	$(RM) $(TARGET) $(OBJS)
	find . -name "*.o" -type f -delete 2>/dev/null || true

.PHONY: clean all
